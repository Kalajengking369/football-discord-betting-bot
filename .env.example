# Discord Bot Token from Discord Developer Portal
DiscordToken=YOUR_DISCORD_BOT_TOKEN_HERE

# Football API Token from football-data.org (free tier available)
FootballApiKey=YOUR_FOOTBALL_DATA_ORG_API_KEY_HERE

# Channel IDs (Right-click channel in Discord with Developer Mode on -> Copy Channel ID)
NotificationChannelId=000000000000000000
LeaderboardChannelId=000000000000000000
ResultsChannelId=000000000000000000
DailyMatchesChannelId=000000000000000000

# Optional: Persistent dashboard message IDs (Leave blank to let the bot auto-generate)
LeaderboardMessageId=
DailyMatchesMessageId=

# Competition & Scheduling (2000 = World Cup, 2021 = Premier League, 2001 = Champions League)
BotSettings__CompetitionId=2000
BotSettings__SyncIntervalMinutes=10
BotSettings__DashboardDays=12

# Database Connection String
ConnectionStrings__DefaultConnection=Data Source=/app/data/betting_bot.db
